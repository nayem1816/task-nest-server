NODE_ENV=development
PORT=4100
LOG_LEVEL=debug

# Origin of the web client. Used for CORS and for links in outgoing emails.
APP_URL=http://localhost:3100
# Extra comma-separated origins allowed by CORS (optional).
CORS_ORIGINS=

DATABASE_URL=postgresql://tasknest:tasknest@localhost:5433/tasknest
REDIS_URL=redis://localhost:6380

SWAGGER_ENABLED=true

# Used by the e2e suite instead of DATABASE_URL.
TEST_DATABASE_URL=postgresql://tasknest:tasknest@localhost:5433/tasknest_test
TEST_REDIS_URL=redis://localhost:6380/1

# Run BullMQ processors in the API process. Set to false on API-only replicas.
WORKERS_ENABLED=true

# HMAC key for access tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
# Leave unset to use Secure cookies everywhere except NODE_ENV=development.
# COOKIE_SECURE=

# Mailpit in development; any SMTP relay (SES, Resend, Postmark) in production.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="TaskNest <no-reply@tasknest.app>"

# Number of reverse proxies in front of the API, so req.ip is the real client.
TRUST_PROXY_HOPS=0

# Shared with the web app (same value there). Lets its server pass the real
# client IP to the API. Generate with: openssl rand -base64 48
EDGE_PROXY_SECRET=

# AI. Leave GEMINI_API_KEY empty to run without AI; the app says so instead of
# failing. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_CHAT_MODEL=gemini-3.8-flash
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_TIMEOUT_MS=30000

# File storage (knowledge base uploads). Local values match docker-compose's
# RustFS; in production use S3 or Cloudflare R2 and drop the path-style flag.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tasknest
S3_ACCESS_KEY_ID=tasknest
S3_SECRET_ACCESS_KEY=tasknest-dev-secret
S3_FORCE_PATH_STYLE=true
