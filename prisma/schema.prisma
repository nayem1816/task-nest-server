generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, vector, pg_trgm]
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

/// A person who can sign in. Users are global; what they can see is decided by
/// their memberships, never by the user row itself.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique @db.Citext
  name            String
  /// Null for accounts created through OAuth only.
  passwordHash    String?
  emailVerifiedAt DateTime?
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships     OrganizationMember[]
  sessions        Session[]
  accountTokens   AccountToken[]
  invitationsSent Invitation[]
}

// ─── Sessions ────────────────────────────────────────────────────────────────

/// One signed-in device or browser. Access tokens carry the session id, so
/// revoking a session cuts off its access token as well as its refresh token.
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  /// Absolute lifetime. Refreshing does not extend it past this point.
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

/// Refresh tokens rotate on every use. The raw token is never stored; a used
/// token presented again means it was copied, and the whole session is revoked.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use tokens sent by email. Stored hashed, like refresh tokens.
model AccountToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @db.Uuid
  purpose   AccountTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

/// The tenant. Every business record hangs off an organization.
model Organization {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String
  /// Used in URLs. Unique across all tenants.
  slug         String    @unique
  businessType String?
  timezone     String    @default("UTC")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Soft delete: data is retained for the grace period, then purged by a job.
  deletedAt    DateTime?

  roles         Role[]
  members       OrganizationMember[]
  teams         Team[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  contacts      Contact[]
  tags          Tag[]
  products      Product[]
  orders        Order[]
  channels      Channel[]
  conversations Conversation[]
}

/// Roles are per organization so a tenant can add custom ones later. The six
/// built-in roles are created with every organization and marked `isSystem`.
model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  /// Stable identifier ("owner", "agent"). Display text lives in `name`.
  key            String
  name           String
  description    String?
  /// Permission keys from the catalog in src/modules/authorization/permissions.ts.
  permissions    String[]
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

model OrganizationMember {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  roleId         String       @db.Uuid
  status         MemberStatus @default(ACTIVE)
  /// Shown to customers when this member replies, if different from the user's name.
  displayName    String?
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: a role cannot be deleted while members still hold it.
  role                  Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  teams                 TeamMember[]
  contactNotes          ContactNote[]
  assignedConversations Conversation[]     @relation("ConversationAssignee")
  messages              Message[]
  conversationReads     ConversationRead[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model Team {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  conversations Conversation[]

  @@unique([organizationId, name])
}

model TeamMember {
  teamId    String   @db.Uuid
  memberId  String   @db.Uuid
  createdAt DateTime @default(now())

  team   Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([teamId, memberId])
  @@index([memberId])
}

/// An emailed invitation to join an organization. Accepting it requires
/// signing in with the invited address.
model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  email          String    @db.Citext
  roleId         String    @db.Uuid
  invitedById    String?   @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

enum ActorType {
  USER
  SYSTEM
  AI
  API_KEY
}

/// Append-only record of who changed what. Rows are never updated; the actor is
/// kept as an id plus a display snapshot so the entry still reads correctly
/// after the user is renamed or removed.
model AuditLog {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  actorType      ActorType
  actorId        String?   @db.Uuid
  actorLabel     String?
  /// Dotted verb, e.g. "member.role_changed".
  action         String
  entityType     String
  entityId       String?
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
}

// ─── Contacts ────────────────────────────────────────────────────────────────

enum LifecycleStage {
  VISITOR
  LEAD
  CUSTOMER
}

/// A person the business talks to. One contact can be reached on several
/// channels; each channel address is a ContactIdentity.
model Contact {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  name           String?
  email          String?        @db.Citext
  phone          String?
  company        String?
  /// Free text, e.g. "Austin, TX". Not geocoded.
  location       String?
  stage          LifecycleStage @default(VISITOR)
  /// Last time the contact did something (message, order, visit).
  lastSeenAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identities    ContactIdentity[]
  tags          ContactTag[]
  notes         ContactNote[]
  activities    ContactActivity[]
  orders        Order[]
  conversations Conversation[]

  /// An email belongs to at most one contact per workspace; NULLs do not collide.
  @@unique([organizationId, email])
  @@index([organizationId, lastSeenAt(sort: Desc)])
  @@index([organizationId, stage])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_email_trgm_idx")
}

enum ChannelType {
  EMAIL
  PHONE
  WEBSITE_CHAT
  TELEGRAM
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

/// How a contact is known on one channel: an email address, a phone number, a
/// chat visitor id, a Telegram user id. Inbound messages are matched to
/// contacts through this table.
model ContactIdentity {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @db.Uuid
  contactId      String      @db.Uuid
  channel        ChannelType
  externalId     String
  createdAt      DateTime    @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channel, externalId])
  @@index([contactId])
}

/// Workspace-wide labels, shared by contacts now and conversations later.
model Tag {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  /// One of a fixed palette of keys ("slate", "blue", ...), not a hex value.
  color          String   @default("slate")
  createdAt      DateTime @default(now())

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts      ContactTag[]
  conversations ConversationTag[]

  @@unique([organizationId, name])
}

model ContactTag {
  contactId String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

model ContactNote {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  contactId      String   @db.Uuid
  authorId       String?  @db.Uuid
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contact Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author  OrganizationMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt(sort: Desc)])
}

/// The contact's timeline. Other domains (conversations, orders, leads) append
/// to it, so the contact page can show one history without joining every table.
model ContactActivity {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  contactId      String   @db.Uuid
  /// Dotted type, e.g. "contact.created", "note.added", "tag.added".
  type           String
  actorId        String?  @db.Uuid
  actorLabel     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, id(sort: Desc)])
}

// ─── Commerce ────────────────────────────────────────────────────────────────

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

/// What the business sells. Money is stored in minor units (cents) to avoid
/// floating point; the currency is per row so a catalogue can be multi-currency.
model Product {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  sku            String?
  description    String?
  category       String?
  priceCents     Int
  currency       String        @default("USD") @db.Char(3)
  /// Null when stock is not tracked.
  stockQuantity  Int?
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                String      @id @default(uuid(7)) @db.Uuid
  organizationId    String      @db.Uuid
  contactId         String?     @db.Uuid
  /// What customers quote ("#10482"). Sequential per workspace.
  number            Int
  status            OrderStatus @default(PENDING)
  currency          String      @default("USD") @db.Char(3)
  subtotalCents     Int
  shippingCents     Int         @default(0)
  totalCents        Int
  shippingAddress   String?
  carrier           String?
  trackingNumber    String?
  estimatedDelivery DateTime?   @db.Date
  placedAt          DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SetNull: deleting a contact keeps the order for the books.
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@unique([organizationId, number])
  @@index([organizationId, placedAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([contactId])
}

/// A line on an order. Name, SKU and price are copied from the product at the
/// time of sale, so later catalogue edits do not rewrite past orders.
model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orderId        String  @db.Uuid
  productId      String? @db.Uuid
  name           String
  sku            String?
  unitPriceCents Int
  quantity       Int
  totalCents     Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// ─── Inbox ───────────────────────────────────────────────────────────────────

enum ChannelStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

/// Where conversations come from: the website widget, an email address, a
/// Telegram bot. Credentials live elsewhere (encrypted); `settings` holds only
/// what is safe to show, such as the widget greeting.
model Channel {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  type           ChannelType
  name           String
  status         ChannelStatus @default(ACTIVE)
  settings       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([organizationId])
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

/// Who is answering. Kept apart from status: a conversation can be OPEN while
/// the AI handles it, or OPEN after the AI escalated it to a person.
enum ConversationHandler {
  AI_HANDLING
  HUMAN_HANDLING
  AI_ESCALATED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Conversation {
  id                 String               @id @default(uuid(7)) @db.Uuid
  organizationId     String               @db.Uuid
  channelId          String               @db.Uuid
  contactId          String               @db.Uuid
  subject            String?
  status             ConversationStatus   @default(OPEN)
  handler            ConversationHandler  @default(HUMAN_HANDLING)
  priority           ConversationPriority @default(NORMAL)
  assigneeId         String?              @db.Uuid
  teamId             String?              @db.Uuid
  /// Why the AI handed over, in words an agent can act on.
  escalationReason   String?
  lastMessageAt      DateTime             @default(now())
  lastMessagePreview String?
  /// Last time the customer wrote. Unread means this is later than the member's lastReadAt.
  lastInboundAt      DateTime?
  /// Set by the first reply a person or the AI sends; used for response-time metrics.
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel             @relation(fields: [channelId], references: [id], onDelete: Restrict)
  contact      Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee     OrganizationMember? @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  team         Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages     Message[]
  tags         ConversationTag[]
  reads        ConversationRead[]

  @@index([organizationId, status, lastMessageAt(sort: Desc)])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, teamId, status])
  @@index([contactId])
}

enum MessageSender {
  CONTACT
  MEMBER
  AI
  SYSTEM
}

model Message {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  conversationId String        @db.Uuid
  sender         MessageSender
  /// The member who wrote it, for MEMBER messages and notes.
  authorId       String?       @db.Uuid
  /// Internal notes are visible to the team only and never sent to the customer.
  internal       Boolean       @default(false)
  body           String
  /// Sender-specific extras, e.g. the AI's sources and confidence, or a system event's details.
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       OrganizationMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, id(sort: Desc)])
}

model ConversationTag {
  conversationId String   @db.Uuid
  tagId          String   @db.Uuid
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
}

/// How far each member has read a conversation; unread counts are computed from it.
model ConversationRead {
  conversationId String   @db.Uuid
  memberId       String   @db.Uuid
  lastReadAt     DateTime

  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member       OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([conversationId, memberId])
  @@index([memberId])
}
